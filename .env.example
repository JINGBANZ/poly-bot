# Copy to .env (git-ignored) and fill in. This is the ONE place for all
# credentials — the bot loads it automatically at startup (bot/config.py).
# chmod 600 .env

# ── Polymarket wallet / trading (required for live trading) ──
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_API_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# ── LLM (required for Longshot Hunter AI gate + research) ──
# DeepSeek is the preferred provider; Anthropic/Gemini are fallbacks.
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ── Optional ──
# X_BEARER_TOKEN=          # Twitter/X news monitoring
# GITHUB_TOKEN=            # evolution loop
