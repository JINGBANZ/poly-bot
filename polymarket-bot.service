[Unit]
Description=Polymarket Trading Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/poly-bot
EnvironmentFile=/opt/poly-bot/.secrets/.polymarket-env
ExecStartPre=/opt/poly-bot/venv/bin/python3 -m pytest bot/tests/ -q --tb=line
ExecStart=/opt/poly-bot/venv/bin/python3 -m bot.main
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
